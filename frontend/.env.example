# API base URL — use /api in dev (proxied by Vite) or full URL in production
VITE_API_BASE_URL=/api

# Vite dev-server proxy target (not exposed to browser)
VITE_API_PROXY_TARGET=http://localhost:8080

# App branding
VITE_APP_NAME=Containerix

# localStorage key for the user's API key (change if you need a unique namespace)
VITE_API_KEY_STORAGE_KEY=containerix_api_key
