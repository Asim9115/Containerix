# HTTP listen address
CONTAINERIX_LISTEN=:8080

# SQLite database file path
CONTAINERIX_DB_PATH=data/containerix.db

# Cgroup / sandbox name
CONTAINERIX_SANDBOX_NAME=containerix

# Max CPU cores for the sandbox (float)
CONTAINERIX_SANDBOX_CPU=2

# Max memory for the sandbox in bytes (string integer)
CONTAINERIX_SANDBOX_MEMORY=3221225472

# Admin API key for /cgroup and /dbports
CONTAINERIX_ADMIN_API_KEY=

# Allow open user registration via POST /users (true|false)
CONTAINERIX_ALLOW_REGISTRATION=true

# Max request body size in bytes (default 1 MiB)
CONTAINERIX_MAX_REQUEST_BODY=1048576

# Global rate limit per client IP (default 120 requests per window; set 0 to disable)
CONTAINERIX_GLOBAL_RATE_LIMIT=120

# Global rate limit window in seconds (default 60 = 1 minute)
CONTAINERIX_GLOBAL_RATE_WINDOW=60

# Registration rate limit per client IP (default 5 attempts per window)
CONTAINERIX_REGISTRATION_RATE_LIMIT=5

# (default 3600 = 1 hour)
CONTAINERIX_REGISTRATION_RATE_WINDOW=3600
